{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "adextract",
  "version": "1.0.0",
  "description": "Connects the agent to adextract's remote MCP server: competitor ad research across Meta, Google, LinkedIn and TikTok public ad libraries, plus ad image and video analysis. All tools are read-only.",
  "author": { "name": "Advertly, Inc.", "url": "https://adextract.co" },
  "homepage": "https://adextract.co",
  "repository": "https://github.com/ad-vertly/adextract-mcp-server",
  "license": "MIT",
  "keywords": ["ads", "advertising", "competitor-research", "marketing", "mcp"],
  "extensions": {
    "com.nousresearch.hermes": {
      "servers": {
        "adextract": { "trust": "untrusted" }
      }
    }
  }
}
